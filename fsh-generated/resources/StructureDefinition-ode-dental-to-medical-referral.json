{
  "resourceType": "StructureDefinition",
  "id": "ode-dental-to-medical-referral",
  "url": "http://hl7.org/fhir/us/ode/StructureDefinition/ode-dental-to-medical-referral",
  "name": "ODEDentalToMedicalReferral",
  "title": "ODE Dental-to-Medical Referral",
  "status": "draft",
  "description": "A dentist refers to a physician (e.g. AI sleep-apnea screening to sleep medicine). The physician acts and bills medically, so medical codes are must-support and CDT is not; SNODENT is should-support to preserve the dental finding. The screening/finding result that motivated the referral is must-support in supportingInfo. Imaging follows as a separate push after this referral (medical-side receivers expose no inbound pull).",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "ServiceRequest",
  "baseDefinition": "http://hl7.org/fhir/us/ode/StructureDefinition/ode-referral-servicerequest",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "ServiceRequest.code.coding",
        "path": "ServiceRequest.code.coding",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "ServiceRequest.code.coding:cpt",
        "path": "ServiceRequest.code.coding",
        "sliceName": "cpt",
        "min": 0,
        "max": "*",
        "mustSupport": true
      },
      {
        "id": "ServiceRequest.code.coding:cpt.system",
        "path": "ServiceRequest.code.coding.system",
        "min": 1,
        "fixedUri": "http://www.ama-assn.org/go/cpt"
      },
      {
        "id": "ServiceRequest.code.coding:hcpcs",
        "path": "ServiceRequest.code.coding",
        "sliceName": "hcpcs",
        "min": 0,
        "max": "*",
        "mustSupport": true
      },
      {
        "id": "ServiceRequest.code.coding:hcpcs.system",
        "path": "ServiceRequest.code.coding.system",
        "min": 1,
        "fixedUri": "http://www.cms.gov/Medicare/Coding/HCPCSReleaseCodeSets"
      },
      {
        "id": "ServiceRequest.code.coding:snodent",
        "path": "ServiceRequest.code.coding",
        "sliceName": "snodent",
        "short": "SHOULD support — SNODENT preserves the dental finding/origin (optional slice, not MS).",
        "min": 0,
        "max": "*"
      },
      {
        "id": "ServiceRequest.code.coding:snodent.system",
        "path": "ServiceRequest.code.coding.system",
        "min": 1,
        "fixedUri": "http://www.ada.org/snodent"
      },
      {
        "id": "ServiceRequest.reasonCode",
        "path": "ServiceRequest.reasonCode",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "coding.system"
            }
          ],
          "rules": "open"
        },
        "min": 1
      },
      {
        "id": "ServiceRequest.reasonCode:icd10",
        "path": "ServiceRequest.reasonCode",
        "sliceName": "icd10",
        "min": 1,
        "max": "*",
        "mustSupport": true
      },
      {
        "id": "ServiceRequest.reasonCode:icd10.coding.system",
        "path": "ServiceRequest.reasonCode.coding.system",
        "min": 1,
        "fixedUri": "http://hl7.org/fhir/sid/icd-10-cm"
      },
      {
        "id": "ServiceRequest.supportingInfo",
        "path": "ServiceRequest.supportingInfo",
        "short": "MS, REQUIRED: the screening/finding result that motivated the referral, plus the clinical note. Supporting imaging (if any) follows as a separate push after this referral, not embedded here.",
        "min": 1
      }
    ]
  }
}
